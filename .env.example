SREDA_ENV=dev
SREDA_LOG_LEVEL=INFO
SREDA_API_HOST=127.0.0.1
SREDA_API_PORT=8000
SREDA_DATABASE_URL=postgresql+psycopg://sreda:sreda@localhost:5432/sreda
SREDA_TELEGRAM_BOT_TOKEN=
SREDA_OPENAI_BASE_URL=
SREDA_OPENAI_API_KEY=
SREDA_OPENAI_MODEL=
SREDA_ENCRYPTION_KEY=

# Second Telegram bot: @sreda_home_bot (Phase 1 — second-tg-bot feature)
# Leave empty to disable the second bot (existing behaviour unchanged).
SREDA_HOME_BOT_TOKEN=
SREDA_HOME_BOT_USERNAME=
SREDA_HOME_MINIAPP_SHORTNAME=
# signup_open for sreda_home: true = auto-approve new users (no moderation).
# anti-abuse (rate-limit, capacity) still applies.
SREDA_HOME_BOT_SIGNUP_OPEN=true

# Bot-key routing (defaults: both point to legacy "sreda" bot).
# Flip to "sreda_home" after Phase 8 cutover.
SREDA_SYSTEM_DEFAULT_BOT_KEY=sreda
SREDA_ADMIN_BOT_KEY=sreda
